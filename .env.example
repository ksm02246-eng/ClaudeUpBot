# Copy to .env (never commit .env). All values below are read by claudeupbot/config.py.

# --- Upstox credentials (from https://account.upstox.com/developer/apps) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
# Upstox access tokens expire daily (around 03:30 IST). Generate a fresh one each day.
UPSTOX_ACCESS_TOKEN=

# --- Safety ---
# Real orders are only sent when this is exactly "true". Default is paper trading.
LIVE_TRADING=false
# Hard ceiling on capital the bot may ever deploy, in INR, even if the wallet holds more.
MAX_CAPITAL=50000
# Fraction of available cash kept untouched as a buffer for charges.
CASH_BUFFER_PCT=0.02
# Max fraction of capital in a single instrument.
MAX_POSITION_PCT=0.25
# Stop opening new positions for the day once realised+unrealised loss exceeds this fraction.
MAX_DAILY_LOSS_PCT=0.03

# --- What to trade ---
# Comma-separated Upstox instrument keys.
INSTRUMENTS=NSE_EQ|INE002A01018,NSE_EQ|INE467B01029
CANDLE_INTERVAL=30minute
RUN_EVERY_MINUTES=15

# --- Files ---
JOURNAL_PATH=data/journal.jsonl
PAPER_STATE_PATH=data/state_paper.json
PAPER_STARTING_CASH=50000
